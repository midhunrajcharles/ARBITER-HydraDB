// Arbiter graph schema - GENERATED by scripts/gen_dbml.py.
// Do not edit by hand; edit arbiter/schema.py and regenerate.
//
// Entity type is encoded in the integer id band, not in a label or a
// column. HydraDB v0.1.0 accepts exactly one batch write form:
//
//   UNWIND $rows AS row CREATE (a {id: row.a})-[:REL]->(b {id: row.b})
//
// which carries ids only - no labels, no node properties, no edge
// properties. So a node cannot be tagged with its type at insert time.
// Instead each entity class owns a disjoint 1,000,000-wide id range and
// a node's type is recoverable from its id alone, with no property
// lookup. That also makes a typed-edge constraint (AUTHORED must point
// at a document) an integer range check the engine answers from the id.
//
// Paste into https://dbdiagram.io/d to render.

Table Role {
  id integer [pk, note: "vertex id"]
  key varchar [note: "role name, e.g. Marketing Research Analyst"]
  Note: "id band 1,000,000 .. 1,999,999"
}

Table Employee {
  id integer [pk, note: "vertex id"]
  key varchar [note: "HERB employee_id, e.g. eid_3bd7cd36"]
  name varchar
  role varchar [note: "denormalised; edge of record is HAS_ROLE"]
  manager_id integer [note: "FK Employee.id via REPORTS_TO; graph edge, not a stored column"]
  Note: "id band 2,000,000 .. 2,999,999"
}

Table Product {
  id integer [pk, note: "vertex id"]
  key varchar [note: "product name, e.g. SearchForce"]
  Note: "id band 3,000,000 .. 3,999,999"
}

Table Release {
  id integer [pk, note: "vertex id"]
  key varchar [note: "release_id"]
  seq integer [note: "ordinal within the product"]
  product_id integer [note: "FK Product.id via OF_PRODUCT"]
  precedes_id integer [note: "FK Release.id via PRECEDES; graph edge, not a stored column"]
  Note: "id band 4,000,000 .. 4,999,999"
}

Table Company {
  id integer [pk, note: "vertex id"]
  key varchar [note: "company name"]
  Note: "id band 5,000,000 .. 5,999,999"
}

Table Customer {
  id integer [pk, note: "vertex id"]
  key varchar [note: "customer id"]
  company_id integer [note: "FK Company.id via WORKS_FOR"]
  Note: "id band 6,000,000 .. 6,999,999"
}

Table Artifact {
  id integer [pk, note: "vertex id; band encodes kind"]
  kind varchar [note: "slack | transcript | pr | url"]
  Note: "id bands 20,000,000+ (slack), 30,000,000+ (transcript), 40,000,000+ (pr), 50,000,000+ (url)"
}

Table Document {
  id integer [pk, note: "vertex id"]
  key varchar [note: "document id"]
  dtype varchar [note: "document type"]
  product_id integer [note: "FK Product.id via OF_PRODUCT"]
  Note: "id band 10,000,000 .. 10,999,999"
}

// -- Relationships. One Ref per edge type in the ontology. --

Ref: Employee.id > Role.id // HAS_ROLE - many-1, 530 edges
Ref: Employee.id < Artifact.id // AUTHORED - 1-many, 45,192 edges
Ref: Artifact.id > Release.id // ABOUT_RELEASE - many-1, 15,326 edges
Ref: Release.precedes_id - Release.id // PRECEDES - 1-1, 70 edges (self-relationship)
Ref: Release.product_id > Product.id // OF_PRODUCT - many-1, 100 edges
Ref: Artifact.id <> Employee.id // MENTIONS - many-many, 12,960 edges
Ref: Employee.manager_id > Employee.id // REPORTS_TO - many-1, 295 edges (self-relationship)
Ref: Artifact.id > Customer.id // REPORTED_BY - many-1; declared but never emitted by build.py (0 edges)
Ref: Customer.company_id > Company.id // WORKS_FOR - many-1, 120 edges
Ref: Artifact.id <> Document.id // REVIEWS - many-many, 2,551 edges
