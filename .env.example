# Arbiter talks to a local HydraDB graph node. There are no API keys and no
# hosted services - these only override defaults if your node differs.

# Address of the HydraDB node. Defaults to the value in .wslip, else 127.0.0.1.
# HYDRA_HOST=172.26.200.199

# Bearer token the node was started with (scripts/hydra_up.sh sets this one).
# HYDRA_TOKEN=local-development-token-32-bytes
